# ==============================================================================
# MonoTransfer — Environment Configuration
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
WS_PORT=3001

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://monotransfer:monopassword123@localhost:5432/monotransfer

# Redis (Used by BullMQ Transfer Queue and WebSocket Pub/Sub)
REDIS_URL=redis://localhost:6379

# Internal Python ytmusicapi Microservice
YTMUSIC_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Security & Cryptography Keys
# ------------------------------------------------------------------------------
# 1. SESSION_SECRET: Minimum 32 random characters for signing JWT session cookies.
# Generate via: openssl rand -base64 32
SESSION_SECRET=e7c8b2104f6918d2a1b94e3390f7a5b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9

# 2. TOKEN_ENCRYPTION_KEY: Exactly 64-char hex string (32 bytes) for AES-256-GCM.
# Stored tokens (Spotify/Google OAuth) are encrypted at rest with AES-256-GCM.
# Generate via: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Spotify Web API
# ------------------------------------------------------------------------------
# 1. Register application at: https://developer.spotify.com/dashboard
# 2. Add Redirect URI: http://localhost:3000/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ------------------------------------------------------------------------------
# Google Cloud / YouTube Data API v3
# ------------------------------------------------------------------------------
# 1. Create project at: https://console.cloud.google.com/
# 2. Enable "YouTube Data API v3"
# 3. Create OAuth 2.0 Web Client Credentials
# 4. Add Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
# 5. Scopes needed:
#    - https://www.googleapis.com/auth/youtube
#    - https://www.googleapis.com/auth/userinfo.email
#    - https://www.googleapis.com/auth/userinfo.profile
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: Server API Key for unauthenticated YouTube Data API search fallback
YOUTUBE_API_KEY=
